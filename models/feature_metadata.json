      },
      "chol": {
        "min": 100,
        "max": 600,
        "default": 210,
        "step": 1,
        "type": "int",
        "unit": "mg/dL"
      },
      "fbs": {
        "options": {
          "Fasting Blood Sugar <= 120 mg/dL (0)": 0,
          "Fasting Blood Sugar > 120 mg/dL (1)": 1
        },
        "default": 0,
        "type": "categorical"
      },
      "restecg": {
        "options": {
          "Normal (0)": 0,
          "ST-T Wave Abnormality (1)": 1,
