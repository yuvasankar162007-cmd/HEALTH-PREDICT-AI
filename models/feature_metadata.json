{
  "diabetes": {
    "raw_features": [
      "Pregnancies",
      "Glucose",
      "BloodPressure",
      "SkinThickness",
      "Insulin",
      "BMI",
      "DiabetesPedigreeFunction",
      "Age"
    ],
    "ranges": {
      "Pregnancies": {
        "min": 0,
        "max": 20,
        "default": 0,
        "step": 1,
        "type": "int"
      },
      "Glucose": {
        "min": 40,
        "max": 300,
        "default": 100,
        "step": 1,
        "type": "float",
        "unit": "mg/dL"
      },
      "BloodPressure": {
        "min": 40,
        "max": 220,
        "default": 75,
        "step": 1,
        "type": "float",
        "unit": "mmHg"
      },
      "SkinThickness": {
        "min": 5,
        "max": 99,
        "default": 20,
        "step": 1,
        "type": "float",
        "unit": "mm"
      },
      "Insulin": {
        "min": 0,
        "max": 900,
        "default": 80,
        "step": 1,
        "type": "float",
        "unit": "mu U/ml"
      },
      "BMI": {
        "min": 10.0,
        "max": 65.0,
        "default": 24.5,
        "step": 0.1,
        "type": "float",
        "unit": "kg/m\u00b2"
      },
      "DiabetesPedigreeFunction": {
        "min": 0.05,
        "max": 2.5,
        "default": 0.47,
        "step": 0.01,
        "type": "float"
      },
      "Age": {
        "min": 18,
        "max": 100,
        "default": 35,
        "step": 1,
        "type": "int",
        "unit": "years"
      }
    }
  },
  "heart": {
    "raw_features": [
      "age",
      "sex",
      "cp",
      "trestbps",
      "chol",
      "fbs",
      "restecg",
      "thalach",
      "exang",
      "oldpeak",
      "slope",
      "ca",
