        "min": 18,
        "max": 100,
        "default": 50,
        "step": 1,
        "type": "int",
        "unit": "years"
      },
      "sex": {
        "options": {
          "Female": 0,
          "Male": 1
        },
        "default": 1,
        "type": "categorical"
      },
      "cp": {
        "options": {
          "Typical Angina (0)": 0,
          "Atypical Angina (1)": 1,
          "Non-anginal Pain (2)": 2,
          "Asymptomatic (3)": 3
        },
        "default": 0,
        "type": "categorical"
      },
      "trestbps": {
        "min": 80,
        "max": 220,
        "default": 120,
        "step": 1,
        "type": "int",
