        },
        "default": 0,
        "type": "categorical"
      },
      "thalach": {
        "min": 60,
        "max": 220,
        "default": 150,
        "step": 1,
        "type": "int",
        "unit": "bpm"
      },
      "exang": {
        "options": {
          "No (0)": 0,
          "Yes (1)": 1
        },
        "default": 0,
        "type": "categorical"
      },
      "oldpeak": {
        "min": 0.0,
        "max": 7.0,
        "default": 1.0,
        "step": 0.1,
        "type": "float",
        "unit": "mm"
      },
      "slope": {
        "options": {
          "Upsloping (0)": 0,
          "Flat (1)": 1,
          "Downsloping (2)": 2
        },
        "default": 1,
        "type": "categorical"
      },
      "ca": {
        "min": 0,
        "max": 4,
        "default": 0,
        "step": 1,
        "type": "int"
      },
      "thal": {
        "options": {
          "Normal (1)": 1,
          "Fixed Defect (2)": 2,
          "Reversible Defect (3)": 3
        },
        "default": 2,
        "type": "categorical"
      }
